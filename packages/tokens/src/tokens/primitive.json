{
  "primitive": {
    "gray": {
      "$type": "color",
      "950": { "$value": "#222831" },
      "900": { "$value": "#393E46" },
      "800": { "$value": "#4A505A" },
      "600": { "$value": "#4F5560" },
      "400": { "$value": "#A8ADB4" },
      "200": { "$value": "#D6D6D6" },
      "100": { "$value": "#EEEEEE" },
      "0": { "$value": "#FFFFFF" }
    },
    "yellow": {
      "$type": "color",
      "400": { "$value": "#FFD369" },
      "800": { "$value": "#8A5F00" }
    },
    "red": {
      "$type": "color",
      "300": { "$value": "#FF8A80" },
      "700": { "$value": "#B3261E" }
    },
    "space": {
      "$type": "dimension",
      "0": { "$value": "0rem" },
      "1": { "$value": "0.25rem" },
      "2": { "$value": "0.5rem" },
      "3": { "$value": "0.75rem" },
      "4": { "$value": "1rem" },
      "6": { "$value": "1.5rem" },
      "8": { "$value": "2rem" },
      "11": { "$value": "2.75rem" },
      "12": { "$value": "3rem" },
      "16": { "$value": "4rem" }
    },
    "radius": {
      "$type": "dimension",
      "2": { "$value": "2px" },
      "4": { "$value": "4px" },
      "8": { "$value": "8px" },
      "full": { "$value": "9999px" }
    },
    "border-width": {
      "$type": "dimension",
      "1": { "$value": "1px" },
      "2": { "$value": "2px" },
      "3": { "$value": "3px" }
    },
    "font-family": {
      "$type": "fontFamily",
      "space-grotesk": { "$value": "'Space Grotesk', system-ui, sans-serif" },
      "inter": { "$value": "'Inter', system-ui, sans-serif" },
      "mono": { "$value": "ui-monospace, 'SF Mono', Menlo, monospace" }
    },
    "font-size": {
      "$type": "dimension",
      "fluid-3xl": { "$value": "clamp(2rem, 1.5rem + 2vw, 3rem)" },
      "fluid-2xl": { "$value": "clamp(1.5rem, 1.25rem + 1vw, 2rem)" },
      "xl": { "$value": "1.25rem" },
      "md": { "$value": "1rem" },
      "sm": { "$value": "0.875rem" }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": "1.1" },
      "snug": { "$value": "1.2" },
      "normal": { "$value": "1.3" },
      "relaxed": { "$value": "1.5" },
      "caption": { "$value": "1.4" }
    }
  }
}
